# ==============================================================================
# Agri_watch - Environment Configuration Template
# Copy this file to .env and populate your actual keys:
#   cp .env.example .env
# ==============================================================================

# 1. Agmarknet / Government Open Data API (Live Mandi Prices)
# Obtain a free key at: https://data.gov.in
API_KEY=your_data_gov_in_api_key_here
DATA_GOV_IN_KEY=your_data_gov_in_api_key_here

# 2. Groq Cloud LLM (Ultra-Low Latency Hindi Cognitive Reasoning)
# Obtain a free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 3. Gnani.ai Indic Speech Engine (Hindi STT & TTS)
# Obtain an API key from Gnani.ai (vachana.ai / Prisma STT + Timbre TTS)
GNANI_API_KEY=your_gnani_api_key_here

# 4. LiveKit Cloud (Real-Time WebRTC Audio & Telephony Pipeline)
# Create a free project at: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# 5. LangSmith Observability Tracing (Optional)
# Obtain from: https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_key_here
LANGSMITH_PROJECT=agriwatch

